{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "markdown": {
    "lineWidth": 80,
    "textWrap": "always"
  },
  "includes": ["**/*.md"],
  "excludes": [
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/target",
    "**/.pytest_cache"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.17.8.wasm"
  ]
}
